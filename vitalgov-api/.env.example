# VitalGov API — Environment Variables
# Copy this to .env and fill in real values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM_STAFF=vitalgov-staff
KEYCLOAK_REALM_CLINICS=vitalgov-clinics
KEYCLOAK_REALM_ADMIN=vitalgov-admin
KEYCLOAK_CLIENT_ID=vitalgov-api
KEYCLOAK_CLIENT_SECRET=change-me

# mTLS
MTLS_CA_CERT=/certs/ca.crt
MTLS_SERVER_CERT=/certs/server.crt
MTLS_SERVER_KEY=/certs/server.key

# PostgreSQL (data sovereignty: af-south-1)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vitalgov
DB_USER=vitalgov_app
DB_PASSWORD=change-me

# Data residency
DATA_RESIDENCY_REGION=af-south-1
ALLOWED_DATA_REGIONS=af-south-1

# Token settings
TOKEN_LIFETIME_SECONDS=600

# Audit
AUDIT_LOG_PATH=/var/log/vitalgov/audit.log

# Anomaly Detection
ANOMALY_AGENT_URL=http://localhost:5001
